{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=novawallet;Username=novawallet;Password=novawallet"
  },
  "Jwt": {
    "SigningKey": "CHANGE_ME_dev_only_signing_key_min_32_bytes!",
    "Issuer": "novawallet-ledger",
    "Audience": "novawallet-clients",
    "AccessTokenLifetimeMinutes": 60
  }
}
